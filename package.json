{
  "name": "jotview",
  "version": "0.7.0",
  "description": "Turn markdown into a jotbins /d link — a CLI and an MCP server. Zero dependencies.",
  "mcpName": "io.github.jotbins/jotview",
  "type": "module",
  "bin": {
    "jotview": "bin/jotview.js"
  },
  "files": [
    "bin",
    "src",
    "vectors.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "version": "node scripts/sync-version.js && git add manifest.json server.json",
    "bundle": "npx -y @anthropic-ai/mcpb pack . jotview.mcpb"
  },
  "keywords": [
    "markdown",
    "jotbins",
    "cli",
    "share",
    "mcp",
    "mcp-server",
    "mermaid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jotbins/jotview.git"
  },
  "homepage": "https://github.com/jotbins/jotview#readme",
  "bugs": {
    "url": "https://github.com/jotbins/jotview/issues"
  }
}
